{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PhotoGeoFinder",
  "version": "2.0.0",
  "identifier": "io.github.ildargiv.photogeofinder",
  "build": { "frontendDist": "../dist" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "PhotoGeoFinder", "width": 1400, "height": 900, "minWidth": 800, "minHeight": 560, "center": true, "dragDropEnabled": false }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "PhotoGeoFinder",
    "shortDescription": "See where any photo was taken",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": true,
        "languages": ["English", "Russian", "SimpChinese", "Japanese", "Korean", "German", "French", "Spanish"]
      }
    }
  }
}
